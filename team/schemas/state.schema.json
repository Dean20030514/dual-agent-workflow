{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "status": {
      "enum": [
        "CREATED",
        "PLANNING",
        "READY",
        "RUNNING",
        "VERIFYING",
        "INTEGRATING",
        "FINAL_REVIEW",
        "PAUSED",
        "COMPLETED",
        "FAILED",
        "CANCELLED",
        "ESCALATED"
      ]
    },
    "tasks": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "status",
    "tasks"
  ],
  "additionalProperties": true
}
