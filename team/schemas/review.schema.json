{
  "type": "object",
  "properties": {
    "verdict": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "blocking_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "consequence": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "caused_by_last_fix": {"type": "string", "enum": ["yes", "no", "dispute"]}
        },
        "required": ["id", "consequence", "evidence", "caused_by_last_fix"],
        "additionalProperties": false
      }
    },
    "verification_needed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "writes_performed": {
      "const": false,
      "type": "boolean"
    }
  },
  "required": [
    "verdict",
    "blocking_issues",
    "verification_needed",
    "writes_performed"
  ],
  "additionalProperties": false
}
