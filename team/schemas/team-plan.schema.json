{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "classification": {
      "type": "object",
      "properties": {
        "level": {
          "enum": [
            "routine",
            "critical"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "level",
        "reasons"
      ],
      "additionalProperties": false
    },
    "mode": {
      "enum": [
        "L1",
        "L2",
        "L3"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "role": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "objective": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "write_scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                },
                "executable": {
                  "type": "string",
                  "minLength": 1
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "timeout_seconds": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "id",
                "executable",
                "args",
                "timeout_seconds"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "permissions": {
            "type": "object",
            "properties": {
              "shell": {
                "type": "boolean"
              },
              "network": {
                "type": "boolean"
              },
              "secrets": {
                "type": "boolean"
              },
              "production": {
                "type": "boolean"
              }
            },
            "required": [
              "shell",
              "network",
              "secrets",
              "production"
            ],
            "additionalProperties": false
          },
          "subagents": {
            "type": "object",
            "properties": {
              "allowed": {
                "type": "boolean"
              },
              "max_depth": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              }
            },
            "required": [
              "allowed",
              "max_depth"
            ],
            "additionalProperties": false
          },
          "optional": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "role",
          "objective",
          "dependencies",
          "write_scope",
          "acceptance",
          "verification",
          "permissions",
          "subagents"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "verification": {
      "type": "object",
      "properties": {
        "final": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "executable": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "id",
              "executable",
              "args",
              "timeout_seconds"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "final"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "require_9p": {
          "type": "boolean"
        },
        "require_fresh_9b": {
          "type": "boolean"
        }
      },
      "required": [
        "require_9p",
        "require_fresh_9b"
      ],
      "additionalProperties": false
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dynamic_roles": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "required": [
    "schema_version",
    "run",
    "classification",
    "mode",
    "capabilities",
    "tasks",
    "verification",
    "review"
  ],
  "additionalProperties": false
}
