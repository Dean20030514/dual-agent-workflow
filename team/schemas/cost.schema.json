{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "known_cost": {
      "type": "number",
      "minimum": 0
    },
    "unknown_usage": {
      "type": "boolean"
    },
    "agents_created": {
      "type": "integer",
      "minimum": 0
    },
    "active_workers": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "known_cost",
    "unknown_usage",
    "agents_created",
    "active_workers"
  ],
  "additionalProperties": false
}
