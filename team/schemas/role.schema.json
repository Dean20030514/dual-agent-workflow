{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "role_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "default_permissions": {
      "type": "object",
      "properties": {
        "shell": {
          "type": "boolean"
        },
        "network": {
          "type": "boolean"
        },
        "secrets": {
          "type": "boolean"
        },
        "production": {
          "type": "boolean"
        }
      },
      "required": [
        "shell",
        "network",
        "secrets",
        "production"
      ],
      "additionalProperties": false
    },
    "default_read_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "default_write_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "subagents": {
      "type": "object",
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "max_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      },
      "required": [
        "allowed",
        "max_depth"
      ],
      "additionalProperties": false
    },
    "critical_triggers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "object",
      "properties": {"preferred": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
      "required": ["preferred"], "additionalProperties": false
    },
    "guidance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "write_scope_policy": {
      "type": "object", "properties": {"mode": {"const": "conflict_files_plus_explicit_glue_scope"}},
      "required": ["mode"], "additionalProperties": false
    },
    "may_change_interfaces": {"type": "boolean", "const": false},
    "may_change_acceptance": {"type": "boolean", "const": false},
    "may_change_tests": {
      "type": "object",
      "properties": {"allowed": {"const": true}, "only_if": {
        "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
        "items": {"enum": ["integration_broke_valid_test", "adaptation_to_approved_contract"]}
      }},
      "required": ["allowed", "only_if"], "additionalProperties": false
    },
    "forbidden": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "escalate_if": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "escalation_triggers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "role_id",
    "display_name",
    "capabilities",
    "default_permissions",
    "default_read_scope",
    "default_write_scope",
    "subagents",
    "critical_triggers",
    "escalation_triggers", "verification", "guidance"
  ],
  "allOf": [{"if": {"properties": {"role_id": {"const": "integration"}}}, "then": {
    "required": ["write_scope_policy", "may_change_interfaces", "may_change_acceptance", "may_change_tests", "forbidden", "escalate_if"]
  }}],
  "additionalProperties": false
}
