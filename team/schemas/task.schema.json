{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "result_schema_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "role": {
      "type": "object",
      "properties": {
        "definition": {"type": "object"},
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "objective": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "permissions": {
      "type": "object",
      "properties": {
        "shell": {
          "type": "boolean"
        },
        "network": {
          "type": "boolean"
        },
        "secrets": {
          "type": "boolean"
        },
        "production": {
          "type": "boolean"
        }
      },
      "required": [
        "shell",
        "network",
        "secrets",
        "production"
      ],
      "additionalProperties": false
    },
    "write_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "subagents": {
      "type": "object",
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "max_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      },
      "required": [
        "allowed",
        "max_depth"
      ],
      "additionalProperties": false
    },
    "base_sha": {
      "type": "string",
      "minLength": 1
    },
    "result_schema": {
      "type": "string",
      "minLength": 1
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "executable": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "executable",
          "args",
          "timeout_seconds"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "role",
    "objective",
    "dependencies",
    "permissions",
    "write_scope",
    "acceptance",
    "subagents",
    "base_sha",
    "result_schema",
    "verification"
  ],
  "additionalProperties": false
}
